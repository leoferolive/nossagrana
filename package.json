{
  "name": "nossagrana",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fast": "turbo run lint:fast",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format:check:changed": "node ./scripts/check-prettier-changed.mjs",
    "coverage:changed-check": "node ./scripts/check-changed-coverage.mjs",
    "security:audit": "pnpm audit --audit-level=high --prod",
    "deps:check": "pnpm outdated -r",
    "deps:update": "pnpm update -r",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "node scripts/quality-gate.mjs",
    "quality:ci": "node scripts/quality-gate.mjs --ci",
    "ratchet:update": "node scripts/ratchet-check.mjs --update",
    "test:scripts": "node --test scripts/*.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^16.4.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "fast-uri@<4.1.3": ">=4.1.3",
      "find-my-way@<9.7.0": ">=9.7.0",
      "fast-jwt@<6.2.4": ">=6.2.4",
      "ws@<8.21.0": ">=8.21.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yaml,yml}": "prettier --write"
  }
}
